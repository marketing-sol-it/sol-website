    <div class="wrap">
      <p class="eyebrow">Legal</p>
      <h1>Impressum.</h1>
    </div>
  </section>
  <section class="band">
    <div class="wrap prose">
      <h2>Responsible for this website</h2>
      <p>oikos Solar, a project of<br />oikos St. Gallen<br />Dufourstrasse 50<br />9000 St. Gallen<br />Switzerland</p>
